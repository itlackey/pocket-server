{
  "name": "pocket-server",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node build/index.js",
    "run:cli": "node src/cli.js",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:watch": "vitest watch",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright test --reporter=html",
    "test:e2e:terminal": "playwright test tests/e2e/terminal-*.spec.js",
    "test:all": "npm run test:unit && npm run test:e2e",
    "playwright:install": "npx playwright install",
    "rebuild:native": "npm rebuild node-pty",
    "prepare": "svelte-kit sync",
    "check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --watch"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.59.0",
    "@sveltejs/adapter-node": "^5.3.2",
    "@xterm/headless": "^5.5.0",
    "chokidar": "^3.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "fuzzysort": "^3.1.0",
    "ignore": "^7.0.5",
    "jose": "^6.0.12",
    "node-pty": "^0.10.1",
    "openai": "^5.19.1",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@sveltejs/kit": "^2.22.0",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@types/cors": "^2.8.17",
    "@types/node": "^20.11.17",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.25.9",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tsx": "^4.7.1",
    "typescript": "^5.8.3",
    "vite": "^7.0.4",
    "vitest": "^2.0.0"
  },
  "description": "Server-authoritative Node.js + Hono HTTP/WS server for Pocket Agent",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/yayasoumah/pocket-server.git"
  },
  "bugs": {
    "url": "https://github.com/yayasoumah/pocket-server/issues"
  },
  "homepage": "https://github.com/yayasoumah/pocket-server#readme"
}
